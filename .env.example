# Cloudflare Workers Preview and Production. This is intentionally public in the browser.
# Use the same Clerk publishable key for both publishable-key variables.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_SITE_URL=https://www.madebywebine.com
VITE_TURNSTILE_SITE_KEY=
# Public R2 custom domain, without a trailing slash. Published snapshots are read here,
# so normal public visits do not invoke a Worker.
VITE_CONTENT_BASE_URL=https://content.your-domain.com

# Cloudflare Workers Preview and Production. Keep the secret key and owner ID server-only.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ADMIN_USER_ID=
CLERK_AUTHORIZED_PARTIES=https://preview.your-domain.com,https://your-future-domain.com

# Cloudflare Workers Preview and Production. Use separate Turso databases or tokens where possible.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# R2 S3 API credentials, bucket endpoint and the public custom-domain base URL. Keep all server-only.
# Include the bucket path: https://<account-id>.r2.cloudflarestorage.com/<bucket-name>
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=
R2_PUBLIC_BASE_URL=https://media.your-domain.com

# Cloudflare Workers Preview and Production. Keep notification values server-only.
# ENQUIRY_HASH_SECRET is required and must be at least 32 characters.
# Generate it locally with: openssl rand -hex 32
# For email alerts, create a Resend API key, choose the private inbox that
# receives enquiries and use a From address on a domain verified in Resend.
# Incomplete Resend values do not block deployment. Enquiries remain stored
# with a pending notification state until all three values are configured.
# The webhook remains an optional alternative to Resend.
ENQUIRY_HASH_SECRET=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=madebywebine.com,www.madebywebine.com
TURNSTILE_EXPECTED_ACTION=contact_enquiry
RESEND_API_KEY=
ENQUIRY_NOTIFICATION_EMAIL=
ENQUIRY_NOTIFICATION_FROM_EMAIL=Webine <enquiries@your-domain.com>
ENQUIRY_NOTIFICATION_WEBHOOK_URL=
ENQUIRY_NOTIFICATION_TOKEN=

# Optional public value displayed on Contact and in the footer.
VITE_PUBLIC_CONTACT_EMAIL=

# Local .env.development only. Never add these to Cloudflare or GitHub.
ADMIN_DEV_BYPASS=false
ADMIN_DEV_LABEL=Local Webine owner

# Optional local backup destination. Never add this to Cloudflare.
WEBINE_BACKUP_DIRECTORY=
